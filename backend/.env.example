NODE_ENV=development
PORT=5001
MONGODB_CONNECTIONSTRING=
JWT_SECRET=
EMAIL_PROVIDER=sendgrid
EMAIL_FROM=
EMAIL_USER=
SENDGRID_API_KEY=
FRONTEND_URL=http://localhost:5173
# Optional comma-separated additional browser origins, including production domains.
# Use "*" to allow every origin (safe for this API because it uses bearer tokens, not cookies).
# Cloudflare *.workers.dev and *.pages.dev origins are always allowed.
CORS_ORIGINS=
