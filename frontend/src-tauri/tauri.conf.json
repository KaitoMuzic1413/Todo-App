{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kaito Todo",
  "version": "3.1.0",
  "identifier": "com.kaito.todox",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "title": "Kaito Todo", "width": 1100, "height": 760, "minWidth": 360, "minHeight": 560 }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data: blob: https:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https: wss:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA2RjM0NzRBNkUyMkQ5NzEKUldSeDJTSnVTa2Z6Qmczbk1aSUlLczN0UzFUb3FrVS9OWlNvY2h4K0hUcDFnUUJtWjNNRzdRd3UK",
      "endpoints": [
        "https://github.com/KaitoMuzic1413/Todo-App/releases/latest/download/latest.json"
      ],
      "windows": { "installMode": "passive" }
    }
  }
}
