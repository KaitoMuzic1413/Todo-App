{
  "name": "frontend",
  "private": true,
  "version": "3.1.0",
  "type": "module",
  "allowScripts": {
    "@parcel/watcher": true,
    "esbuild": true
  },
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js",
    "build": "node node_modules/vite/bin/vite.js build",
    "build:android": "npm run build && node node_modules/@capacitor/cli/bin/capacitor sync android",
    "android:open": "node node_modules/@capacitor/cli/bin/capacitor open android",
    "android:run": "node node_modules/@capacitor/cli/bin/capacitor run android",
    "android:bundle": "npm run build:android && cd android && ./gradlew bundleRelease",
    "android:icons": "sh scripts/generate-android-icons.sh",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "npm run build && tauri build",
    "tauri:build:linux": "tauri build --bundles appimage",
    "tauri:build:windows": "tauri build --bundles nsis",
    "lint": "node node_modules/eslint/bin/eslint.js .",
    "test": "node --test",
    "preview": "node node_modules/vite/bin/vite.js preview"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.102.2",
    "@tauri-apps/api": "^2.12.3",
    "@tauri-apps/cli": "^2.12.1",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.13.3",
    "@vitejs/plugin-react": "^4.7.0",
    "axios": "^1.19.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "framer-motion": "^13.1.0",
    "lucide-react": "^1.30.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "react-router-dom": "^7.18.3",
    "shadcn": "^4.16.2",
    "socket.io-client": "^4.8.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vite": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "sass": "^1.72.0"
  }
}
